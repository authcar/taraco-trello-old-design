# Copy to .env and fill from Supabase: Project Settings -> API
# (the .env file is gitignored; never commit real keys)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key
# Google Calendar API key — untuk fetch hari libur nasional Indonesia di Analytics
VITE_GCAL_KEY=YOUR-google-calendar-api-key
